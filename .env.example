APP_NAME="Events Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@awj.om"
MAIL_FROM_NAME="Mawsim"

# Landing page "Book a demo" form (see config/landing.php)
DEMO_REQUEST_TO=systems@awj.om
DEMO_REQUEST_CC=
DEMO_REQUEST_CONFIRMATION=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Bank Muscat Payment Gateway
# Test/UAT URL: https://spayuattrns.bmtest.om/transaction.do?command=initiateTransaction
# Production URL: https://services.bng.gov.om:8989/transaction.do?command=initiateTransaction
BANK_MUSCAT_GATEWAY_URL=https://spayuattrns.bmtest.om/transaction.do?command=initiateTransaction
BANK_MUSCAT_ACCESS_CODE=your_access_code_here
BANK_MUSCAT_WORKING_KEY=your_working_key_here
BANK_MUSCAT_MERCHANT_ID=your_merchant_id_here

# iSmartSMS gateway (OTP delivery)
ISMARTSMS_URL=https://www.ismartsms.net/iBulkSMS/HttpWS/SMSDynamicAPI.aspx
ISMARTSMS_USER_ID=your_ismartsms_user_id
ISMARTSMS_PASSWORD=your_ismartsms_password

# Payment driver: thawani (default) | bankmuscat | fake (local "Simulate
# success/failure" page, refused in production). Credentials below are the
# platform fallback; tenants can override them in the admin panel.
PAYMENT_DRIVER=thawani
# Thawani Pay (docs/payments_thawani.md): uat | production, keys from the
# Thawani merchant portal.
THAWANI_MODE=uat
THAWANI_SECRET_KEY=
THAWANI_PUBLISHABLE_KEY=
THAWANI_WEBHOOK_SECRET=
PAYMENT_LINK_TTL_MINUTES=60
# Base URL of the gate box office payment links (/pay/{token}); defaults to APP_URL.
# Phones scanning the gate QR must reach it, e.g. http://192.168.1.20:8002 on a LAN.
PAY_LINK_BASE_URL=
PAY_TOKEN_TTL_SECONDS=60

# Multi-tenancy: tenant used when the X-Tenant header is missing.
TENANCY_DEFAULT_TENANT=north-batinah
TENANCY_CONFIG_CACHE_TTL=300

# OTP: OTP_DEBUG=true returns the code in the send-otp response (never in
# production). OTP_TTL_MINUTES / OTP_MAX_ATTEMPTS tune expiry and attempts.
OTP_DEBUG=false
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5

# Optional comma-separated IP allowlist for the Bank Muscat webhook.
BANK_MUSCAT_WEBHOOK_IPS=

# Fixed OTP for local/testing only. Leave blank in production.
OTP_TEST_CODE=

# AI Experience (OpenAI Responses API). The key is read only via
# config('services.openai.key') and never logged. Empty = AI features off.
OPENAI_API_KEY=
# fast: visitor concierge, daily briefing, gate insights (default gpt-6-luna)
OPENAI_MODEL_FAST=
# smart: plan my visit, admin copilot (default gpt-6.1-sol)
OPENAI_MODEL_SMART=
# Default https://api.openai.com/v1
OPENAI_BASE_URL=
